# Riviamigo Synology DSM configuration
# Copy this file to .env.synology and replace every CHANGE_ME value.
# CHANGE_ME is intentionally invalid. Production startup must fail until you
# replace it with at least 32 random bytes.

POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RIVIAMIGO_SETUP_TOKEN=CHANGE_ME

ALLOWED_ORIGINS=https://riviamigo.example.net
RIVIAMIGO_DATA_DIR=/volume1/docker/riviamigo/data
RIVIAMIGO_ORIGIN_PORT=8080
ALLOW_INSECURE_LAN_HTTP_AUTH=false
TZ=America/Chicago
