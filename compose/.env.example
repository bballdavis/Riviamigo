# Riviamigo standard production configuration.
# Copy this file to the environment file used by Compose and replace each CHANGE_ME value.
# Optional settings are listed in compose/.env.full.example and documented at
# https://riviamigo.com/docs/reference/environment-variables/

POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ALLOWED_ORIGINS=https://riviamigo.example.net
# New installations use Docker-managed volumes. Existing installations that do
# not set these variables continue to use RIVIAMIGO_DATA_DIR/../data bind paths.
RIVIAMIGO_DB_SOURCE=riviamigo-db
RIVIAMIGO_REDIS_SOURCE=riviamigo-redis
RIVIAMIGO_BACKUPS_SOURCE=riviamigo-backups
RIVIAMIGO_CACHE_SOURCE=riviamigo-cache
RIVIAMIGO_HOST_BIND_ADDRESS=0.0.0.0
RIVIAMIGO_ORIGIN_PORT=8080
RIVIAMIGO_BIND_ADDRESS=127.0.0.1
RIVIAMIGO_SETUP_TOKEN=CHANGE_ME_FIRST_OWNER_TOKEN_32_BYTES_MINIMUM
# LAN-only HTTP login is insecure. Leave false unless following the documented
# private-network-only procedure: https://riviamigo.com/docs/operations/secure-remote-access/
ALLOW_INSECURE_LAN_HTTP_AUTH=false
TZ=UTC
