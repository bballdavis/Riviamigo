# Riviamigo Synology DSM configuration
# Copy this file to compose/.env.synology and replace every CHANGE_ME value.

POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Exact HTTPS origin configured in DSM Reverse Proxy
ALLOWED_ORIGINS=https://riviamigo.example.net

# Select the actual Synology volume and shared-folder path.
# /volume1 is an example; /volume2 is also valid.
RIVIAMIGO_DATA_DIR=/volume1/docker/riviamigo/data

RIVIAMIGO_ORIGIN_PORT=8080
ALLOW_INSECURE_LAN_HTTP_AUTH=false
TZ=America/Chicago
