{
  "name": "riviamigo",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "node": ">=24.18 <25",
    "pnpm": ">=11.15 <12"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:stack": "node ./scripts/dev.mjs",
    "dev:harness": "node ./scripts/dev-harness.mjs",
    "dev:harness:procedure": "node ./scripts/dev-harness-procedure.mjs",
    "build": "turbo build",
    "test": "pnpm test:packages && pnpm test:scripts",
    "test:packages": "turbo test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:api": "cargo test --manifest-path apps/api/Cargo.toml --all --all-features",
    "test:e2e": "pnpm --filter @riviamigo/web test:e2e",
    "test:coverage": "pnpm --filter @riviamigo/web test:coverage",
    "verify:local": "node ./scripts/local-ci.mjs local",
    "verify:ci": "node ./scripts/local-ci.mjs ci",
    "hooks:install": "node ./scripts/local-ci.mjs install-hooks",
    "hooks:uninstall": "node ./scripts/local-ci.mjs uninstall-hooks",
    "pr:create": "node ./scripts/local-ci.mjs create-pr",
    "verify": "pnpm lint && pnpm typecheck && pnpm docs:check && pnpm deps:check && pnpm architecture:check && pnpm test && pnpm test:api",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "docs:dev": "pnpm --filter @riviamigo/docs start",
    "docs:build": "pnpm --filter @riviamigo/docs build",
    "docs:serve": "pnpm --filter @riviamigo/docs serve",
    "docs:check": "node ./scripts/check-docs.mjs",
    "architecture:check": "node ./scripts/check-architecture-guards.mjs",
    "security:routes": "node ./scripts/check-api-route-security.mjs",
    "deps:check": "node ./scripts/check-dependency-policy.mjs && knip --dependencies",
    "deps:catalogs": "node ./scripts/check-dependency-policy.mjs --catalogs-only",
    "verify:fresh-install": "node ./scripts/verify-fresh-install.mjs",
    "verify:populated-upgrade": "node ./scripts/verify-populated-upgrade.mjs",
    "verify:backup-restore-s3": "node ./scripts/verify-backup-restore-s3.mjs",
    "verify:restore-compatibility": "node ./tools/restore-lab/run.mjs",
    "verify:migration-integrity": "node ./tools/migration-integrity.mjs",
    "verify:image": "node ./scripts/verify-release-image.mjs --platforms linux/amd64",
    "verify:release-image": "node ./scripts/verify-release-image.mjs",
    "compose:check": "node ./scripts/check-compose-contracts.mjs",
    "release-workflows:check": "node ./scripts/check-release-workflows.mjs",
    "compose:render-check": "node ./scripts/validate-compose.mjs",
    "dashboards:sync-defaults": "node ./scripts/sync-dashboard-defaults.mjs",
    "charts:sync-defaults": "node ./scripts/sync-chart-defaults.mjs",
    "themes:generate": "pnpm --filter @riviamigo/themes generate",
    "themes:check": "pnpm --filter @riviamigo/themes check",
    "storybook": "turbo storybook",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "node ./scripts/database.mjs migrate",
    "db:reset": "node ./scripts/database.mjs reset",
    "db:rebaseline": "cd apps/api && cargo run --bin rebaseline_db --",
    "graph:explore": "cargo run --manifest-path tools/graph-exploration/Cargo.toml --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint-react/eslint-plugin": "^5.17.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "knip": "^6.27.0",
    "prettier": "^3.9.5",
    "yaml": "^2.9.0",
    "turbo": "^2.10.5"
  },
  "knip": {
    "ignoreDependencies": [
      "@cmfcmf/docusaurus-search-local",
      "@cmfcmf/docusaurus-plugin-docusaurus-search-local",
      "@riviamigo/config",
      "@riviamigo/ui",
      "prettier"
    ]
  }
}
